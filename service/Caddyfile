{
	admin off
	auto_https off
	persist_config off
}

http://:80 {
	# Set by start.py on each launch. Never use a wildcard interface.
	bind {$PORTMAP_BIND}

	@port {
		vars_regexp port {host} `(?i)^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})\.localhost\.?$`
		not host 80.localhost 80.localhost.
	}
	handle @port {
		reverse_proxy localhost:{re.port.1} {
			header_up Host localhost:{re.port.1}
		}
	}
	handle {
		respond "PortMap: use http://PORT.localhost (1-65535, except proxy port 80)." 404
	}
}
